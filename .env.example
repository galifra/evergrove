# Anthropic API key — get one at https://console.anthropic.com
# This is a separate, pay-per-token API key. It is NOT your Claude.ai / Claude Code
# subscription, and using it here does not touch or count against that usage.
ANTHROPIC_API_KEY=

# Optional: override the model used to parse entries (defaults to a cheap Haiku model)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: a shared secret that guards the API routes so a stranger who finds
# your deployed URL can't burn through your API budget. If set here, the app's
# Settings panel needs the same code entered once (stored in that browser's
# localStorage).
APP_ACCESS_CODE=

# --- Background push notifications (the "reminder even when the app is
# closed" feature) ---

# VAPID keypair identifies this app to push services. Generate once with:
#   npx web-push generate-vapid-keys
# The public key is also hardcoded client-side in src/lib/push.js (VAPID
# keys are not secret on the public side — only the private key is).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Vercel sets this automatically for Cron-triggered requests once you add a
# CRON_SECRET value in the project's env vars — the /api/send-reminder route
# checks it matches so nobody else can trigger pushes. Any random string.
CRON_SECRET=

# Auto-populated once you connect an Upstash Redis (or "Vercel KV") storage
# integration to the project in the Vercel dashboard — see README.
KV_REST_API_URL=
KV_REST_API_TOKEN=
